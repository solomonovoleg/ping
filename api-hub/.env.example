API_HUB_PORT=3092
API_HUB_BASE_URL=http://localhost:3092
API_HUB_ENV=development
API_HUB_LOG_LEVEL=debug
API_HUB_JWT_SECRET=replace_me_secret
API_HUB_ENCRYPTION_KEY=replace_me_32_bytes_secret_value
API_HUB_OAUTH_CLIENT_ID=hub-client-id
API_HUB_OAUTH_CLIENT_SECRET=hub-client-secret
API_HUB_OAUTH_REDIRECT_URI=http://localhost:3092/v1/auth/ping/callback
API_HUB_DB_URL=postgres://postgres:postgres@localhost:5437/api_hub
API_HUB_MEDIA_DIR=./tmp-media

# mock | oidc
API_HUB_AUTH_MODE=mock
API_HUB_PING_OIDC_ISSUER=
API_HUB_PING_OIDC_CLIENT_ID=
API_HUB_PING_OIDC_CLIENT_SECRET=

# Optional: cross-instance realtime
# При наличии URL также включается распределённая идемпотентность моста (ключи apihub:bridge:idem:*)
API_HUB_REDIS_URL=
API_HUB_REDIS_CHANNEL=apihub:fanout

# Optional: direct uploads to S3-compatible storage
# Для Cloud.ru и т.п. обязательно тот же endpoint, что на платформе, например https://s3.cloud.ru
API_HUB_S3_ENDPOINT=
API_HUB_S3_BUCKET=
API_HUB_S3_REGION=eu-central-1
API_HUB_S3_ACCESS_KEY=
API_HUB_S3_SECRET_KEY=
API_HUB_S3_PUBLIC_BASE_URL=

# Optional: proxy /v1/me (и будущие прокси к /api/*) на основной PING
API_HUB_PING_PLATFORM_URL=
# Тот же секрет, что API_HUB_SERVICE_SECRET на сервере платформы — обмен на Bearer pm.*
API_HUB_SERVICE_SECRET=
#
# Платформа шлёт сюда новые сообщения чата (Bearer = этот секрет; на платформе API_HUB_BRIDGE_SECRET)
API_HUB_BRIDGE_SECRET=
# Только эти IP для моста (пусто = без проверки). За nginx: API_HUB_BRIDGE_TRUST_X_FORWARDED=1
# API_HUB_BRIDGE_ALLOWED_IPS=127.0.0.1,::1
# API_HUB_BRIDGE_TRUST_X_FORWARDED=0

# Optional: antivirus hook (stub logs until wired)
API_HUB_CLAMAV_URL=
