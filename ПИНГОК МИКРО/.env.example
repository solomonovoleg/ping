# Порт HTTP микросервиса ПИНГОК МИКРО (не пересекать с основным PORT=3080)
PINGOK_MICRO_PORT=3091

# Лимит POST /v1/parse на один IP за окно rate-limit (см. express-rate-limit, window 60 с)
# PINGOK_MICRO_PARSE_PER_MIN=60

# Опционально: ограничить CORS (в dev по умолчанию разрешены localhost)
# PINGOK_MICRO_CORS_ORIGIN=http://localhost:5000
