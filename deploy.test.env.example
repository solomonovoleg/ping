# =============================================================================
# Шаблон тестового слоя: скопируй в deploy.test.env (файл в .gitignore).
#   cp deploy.test.env.example deploy.test.env && chmod 600 deploy.test.env
#
# npm run deploy:test = deploy.env (база) + deploy.test.env (перекрытия).
# Создай deploy.env: cp deploy.env.example deploy.env и заполни ключи.
# =============================================================================
#
# Если в deploy.env нет S3 / FCM, для теста допустимо:
#   export DEPLOY_SKIP_ENV_VERIFY=1
# Иначе добавь S3_* и FCM_SERVER_KEY в deploy.env (как на проде или отдельный бакет).
#
# На VPS один раз для EDGE:
#   sudo -u postgres psql -c "CREATE DATABASE ping_moot_edge_test OWNER ping_moot_test;"
#
# Nginx pingdepo.ru — location /pingok-micro-standalone/ → 127.0.0.1:5591
#   см. scripts/patch-pingdepo-nginx-pingok.sh
# =============================================================================

export DEPLOY_SKIP_ENV_VERIFY=1

export VPS_PATH=/var/www/ping-moot-test
export PM2_APP_NAME=ping-moot-test
export PORT=5550

export DATABASE_URL="postgresql://ping_moot_test:ПАРОЛЬ@localhost:5432/ping_moot_test"
export EDGE_DATABASE_URL="postgresql://ping_moot_test:ПАРОЛЬ@localhost:5432/ping_moot_edge_test"

# New-Tel: ключи задаются в deploy.env (база для deploy:test). Алиасы NEWTEL_AUTH_KEY / NEWTEL_SIGN_KEY тоже читает скрипт деплоя и пишет на VPS как NEW_TEL_*.
# Регистрация только после звонка New-Tel + ключи (см. deploy.env.example). Иначе при пустых ключах регистрация могла проходить без звонка.
# Legacy (не читается кодом). Регистрация со звонком — только админка → Операции → платформа.
# export REGISTER_REQUIRE_PHONE_CALL_VERIFICATION=1
# export NEW_TEL_AUTH_KEY=
# export NEW_TEL_SIGN_KEY=

export SESSION_SECURE=true
export SESSION_MAX_AGE_DAYS=31
export SESSION_COOKIE_DOMAIN=.pingdepo.ru
export PING_INVITE_APP_URL=https://pingdepo.ru
export PLATFORM_PORT=5550
export CORS_ALLOWED_ORIGINS=https://pingdepo.ru,https://www.pingdepo.ru
export CORS_REFLECT_ORIGIN_COMPAT=0
export CSRF_ALLOWED_ORIGINS=https://pingdepo.ru,https://www.pingdepo.ru
export CSRF_ENFORCE=0
export UPLOADS_CHAT_PRIVATE_ENFORCE=0
export UPLOADS_VOICE_PRIVATE_ENFORCE=0
export SECURITY_AUDIT_DISABLED=0

export VITE_SITE_ORIGIN=https://pingdepo.ru
export VITE_API_URL=https://pingdepo.ru
export VITE_WS_URL=https://pingdepo.ru
export VITE_PINGOK_MICRO_URL=https://pingdepo.ru/pingok-micro-standalone

export PG_POOL_MAX=28

export PINGOK_MICRO_PM2_ENABLED=1
export PINGOK_MICRO_PORT=5591
export PINGOK_PM2_NAME=pingok-micro-test
export PINGOK_MICRO_CORS_ORIGIN=https://pingdepo.ru,https://www.pingdepo.ru

export EDGE_PM2_ENABLED=1
export EDGE_PM2_NAME=ping-moot-edge-test
export EDGE_PORT=5592
export EDGE_BIND=127.0.0.1
export EDGE_UPSTREAM_URL=http://127.0.0.1:5592
export EDGE_PROXY_TIMEOUT_MS=2500
export EDGE_SERVICE_SECRET=
# openssl rand -hex 32

export PARSER_PM2_ENABLED=1
export PARSER_PM2_NAME=ping-moot-parser-test
export PARSER_PORT=5593
export PARSER_BIND=127.0.0.1
export PARSER_UPSTREAM_URL=http://127.0.0.1:5593
export PARSER_PLATFORM_URL=http://127.0.0.1:5550
export PARSER_PROXY_TIMEOUT_MS=25000
export PARSER_SERVICE_SECRET=
export VK_PARSER_TOKEN_KEY=

export FEED_WORKER_PM2_ENABLED=1
export FEED_WORKER_PM2_NAME=ping-moot-test-feed-worker
export FEED_WORKER_INTERVAL_SEC=90
export FEED_SNAPSHOT_MAX_AGE_SEC=180
export FEED_SNAPSHOT_READ_ENABLED=1

# VPS (если не в deploy.env):
# export VPS_HOST=
# export VPS_USER=root
# export VPS_PASSWORD=
