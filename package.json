{
  "name": "rest-express",
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:client": "vite dev --port 5000",
    "dev:pingok-micro": "tsx \"ПИНГОК МИКРО/server/index.ts\"",
    "dev:edge": "tsx EDGE/server/index.ts",
    "dev:parser": "tsx PARSER/server/index.ts",
    "dev:with-parser": "concurrently -k -n platform,parser -c blue,magenta \"npm run dev\" \"npm run dev:parser\"",
    "dev:feed-worker": "tsx server/feed-worker/index.ts",
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "node --import tsx script/build.ts",
    "backup": "bash scripts/backup-project.sh",
    "deploy": "bash scripts/deploy.sh",
    "deploy:preflight": "bash scripts/preflight-prod-env.sh",
    "check:ios-calls-env": "bash scripts/check-ios-calls-env.sh",
    "new-tel:smoke": "node scripts/new-tel-smoke.cjs deploy.env",
    "deploy:test": "DEPLOY_MERGE_WITH=deploy.env DEPLOY_ENV_FILE=deploy.test.env bash scripts/deploy.sh",
    "deploy:test:init": "bash scripts/bootstrap-deploy-test-env.sh",
    "deploy:upload-apns-voip-key": "bash scripts/upload-apns-voip-key.sh",
    "deploy:migrate": "bash scripts/migrate-on-server.sh",
    "deploy:migrate:test": "bash scripts/migrate-on-test-server.sh",
    "deploy:seed-social": "bash scripts/seed-social-on-server.sh",
    "start": "NODE_ENV=production node dist/index.cjs",
    "start:3080": "PORT=3080 NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "test:report-targets": "node --import tsx --test server/admin/ops/is-valid-report-target.test.ts server/reports/parse-content-report-reason/parse-content-report-reason.test.ts",
    "audit:storage": "node scripts/audit-storage-contract.mjs",
    "review:smoke": "node scripts/review-smoke-check.cjs",
    "review:smoke:public": "node scripts/review-smoke-check.cjs --public",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "db:migrate:post-link-codes": "node scripts/migrate-post-link-codes.cjs",
    "migrate:heic-uploads": "tsx scripts/migrate-heic-uploads.ts",
    "backfill:post-video-posters": "tsx scripts/backfill-post-video-posters.ts",
    "db:add-user-columns": "tsx scripts/add-missing-user-columns.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:admin:prod": "node dist/seed-admin.cjs",
    "seed:first-user": "tsx scripts/seed-first-user.ts",
    "seed:first-user:prod": "node dist/seed-first-user.cjs",
    "seed:test-users": "tsx scripts/seed-test-users.ts",
    "seed:social-content": "tsx scripts/seed-social-content.ts",
    "seed:social-fresh": "tsx scripts/seed-social-content.ts --reset --allow-fallback",
    "delete:seed-stories": "tsx scripts/delete-seed-stories.ts",
    "delete:seed-stories:prod": "node dist/delete-seed-stories.cjs",
    "seed:auto-follow": "tsx scripts/run-seed-auto-follow.ts",
    "capacitor:assets": "node scripts/prepare-capacitor-assets.mjs && npx @capacitor/assets generate --android --iconBackgroundColor '#ffffff' --iconBackgroundColorDark '#18181b' --splashBackgroundColor '#09090b' --splashBackgroundColorDark '#09090b' --logoSplashScale 0.24 && npx @capacitor/assets generate --ios --iconBackgroundColor '#ffffff' --iconBackgroundColorDark '#18181b' --splashBackgroundColor '#09090b' --splashBackgroundColorDark '#09090b' --logoSplashScale 0.24",
    "build:android": "npm run capacitor:assets && npm run build && npx cap sync android",
    "build:android:prod": "npm run capacitor:assets && bash scripts/capacitor-build-prod-client.sh && npx cap sync android",
    "cap:sync": "npx cap sync",
    "android": "npx cap open android",
    "android:run": "npm run build:android && npx cap run android",
    "android:apk:full": "npm run build:android && cd android && ./gradlew assembleDebug && cd .. && node scripts/copy-android-debug-apk-to-dist.mjs",
    "android:apk:full:prod": "npm run build:android:prod && cd android && ./gradlew assembleDebug && cd .. && node scripts/copy-android-debug-apk-to-dist.mjs",
    "android:apk": "node scripts/check-android-web-assets.mjs && cd android && ./gradlew assembleDebug && cd .. && node scripts/copy-android-debug-apk-to-dist.mjs",
    "android:apk:release": "cd android && ./gradlew assembleRelease",
    "android:aab:release": "cd android && ./gradlew bundleRelease",
    "build:ios": "npm run capacitor:assets && npm run build && npx cap sync ios",
    "build:ios:prod": "npm run capacitor:assets && bash scripts/capacitor-build-prod-client.sh && npx cap sync ios",
    "build:native:prod": "npm run capacitor:assets && bash scripts/capacitor-build-prod-client.sh && npx cap sync ios && npx cap sync android",
    "build:ios:prod:copy": "npm run capacitor:assets && bash scripts/capacitor-build-prod-client.sh && npx cap copy ios",
    "ios": "npx cap open ios",
    "ios:pod-install": "cd ios/App && pod install",
    "mobile": "cd mobile && npm start",
    "mobile:install": "cd mobile && npm install",
    "dev:api-hub": "npm run dev --prefix api-hub",
    "check:api-hub": "npm run check --prefix api-hub",
    "test:api-hub": "npm run test --prefix api-hub",
    "build:api-hub": "npm run build --prefix api-hub",
    "db:migrate:api-hub": "npm run db:migrate --prefix api-hub",
    "db:seed:api-hub": "npm run db:seed --prefix api-hub"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1010.0",
