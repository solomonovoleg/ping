{
  "name": "rest-express",
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:client": "vite dev --port 5000",
    "dev:pingok-micro": "tsx \"ПИНГОК МИКРО/server/index.ts\"",
    "dev:edge": "tsx EDGE/src/index.ts",
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "deploy": "bash scripts/deploy.sh",
    "deploy:migrate": "bash scripts/migrate-on-server.sh",
    "deploy:seed-social": "bash scripts/seed-social-on-server.sh",
    "start": "NODE_ENV=production node dist/index.cjs",
    "start:3080": "PORT=3080 NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "db:add-user-columns": "tsx scripts/add-missing-user-columns.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:admin:prod": "node dist/seed-admin.cjs",
    "seed:first-user": "tsx scripts/seed-first-user.ts",
    "seed:first-user:prod": "node dist/seed-first-user.cjs",
    "seed:test-users": "tsx scripts/seed-test-users.ts",
    "seed:social-content": "tsx scripts/seed-social-content.ts",
    "seed:social-fresh": "tsx scripts/seed-social-content.ts --reset --allow-fallback",
    "seed:auto-follow": "tsx scripts/run-seed-auto-follow.ts",
    "build:android": "npm run build && npx cap sync android",
    "build:android:prod": "VITE_API_URL=https://pingos.ru npm run build && npx cap sync android",
    "cap:sync": "npx cap sync",
    "android": "npx cap open android",
    "android:run": "npm run build:android && npx cap run android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:apk:release": "cd android && ./gradlew assembleRelease",
    "android:aab:release": "cd android && ./gradlew bundleRelease",
    "build:ios": "npm run build && npx cap sync ios",
    "build:ios:prod": "VITE_API_URL=https://pingos.ru VITE_WS_URL=https://pingos.ru npm run build && npx cap sync ios",
    "ios": "npx cap open ios",
    "mobile": "cd mobile && npm start",
    "mobile:install": "cd mobile && npm install"
  },
