# Порт приложения (на VPS — только этот проект на 3080)
PORT=3080

# Таймауты звонков на сервере (мс). По умолчанию: 60000 (звонок и ожидание офлайн), 90000 (TTL pending).
# CALLS_RING_TIMEOUT_MS=60000
# CALLS_CALLER_WAIT_MS=60000
# CALLS_PENDING_TTL_MS=90000
# Подробные серверные логи сигналинга звонков (initiate/accept/offer/answer/ice): 1 = включить
# CALLS_DEBUG=1
# Пауза (мс) после обрыва WebSocket звонков: если за это время сокет не восстановился — сессия снимается (мобильный слабый сигнал — можно 45000–60000).
# CALLS_DISCONNECT_GRACE_MS=25000

# Клиент (сборка): если SPA и API на разных origin — база REST (без слэша в конце).
# VITE_API_URL=https://api.pingos.ru
# Для звонков WebSocket должен быть доступен. Если фронт за прокси,
# задайте базовый URL WebSocket (без слэша), например https://pingos.ru → wss://pingos.ru/calls
# VITE_WS_URL=https://pingos.ru

# TURN-сервер для звонков (если за симметричным NAT/файрволом P2P не поднимается).
# Креды = те же, что в /etc/turnserver.conf (user=username:password). См. docs/CALLS_TURN_SETUP.md
# Пример (pingos.ru, coturn 3478):
# VITE_TURN_URLS=turn:pingos.ru:3478?transport=udp,turn:pingos.ru:3478?transport=tcp
# VITE_TURN_USERNAME=логин_из_coturn
# VITE_TURN_CREDENTIAL=пароль_из_coturn

# Таймауты звонков на клиенте (мс). Сервер: CALLS_RING_TIMEOUT_MS и др. в этом же файле — держите в согласованности.
# VITE_CALLS_RING_TIMEOUT_MS=60000
# VITE_CALLS_ACCEPT_TIMEOUT_MS=15000
# VITE_CALLS_CONNECT_TIMEOUT_MS=20000
# VITE_CALLS_RECONNECT_TIMEOUT_MS=8000
# Feature flags для модульных улучшений звонков (по умолчанию выключены).
# VITE_CALLS_FEATURE_NETWORK_QUALITY=1
# VITE_CALLS_FEATURE_CAMERA_FLIP=1
# VITE_CALLS_FEATURE_SCREEN_SHARE=1
# VITE_CALLS_FEATURE_LOCAL_RECORDING=1
# VITE_CALLS_FEATURE_REACTIONS=1
# VITE_CALLS_FEATURE_CAPTIONS_RELAY=1

# Групповые звонки (отдельный модуль; по умолчанию выкл). Не трогает тет-а-тет.
# Экран в групповом видеозвонке: включите VITE_CALLS_FEATURE_SCREEN_SHARE=1 (см. выше).
# VITE_GROUP_CALLS_ENABLED=1
# GROUP_CALLS_ENABLED=1
# VITE_GROUP_CALLS_SERVER_ASR=1
# GROUP_CALLS_SERVER_ASR_ENABLED=1
# Титры: по умолчанию клиент шлёт webm-чанки на HTTP (CALL_TRANSCRIPTS_ASR_URL). PCM+WS — только если явно:
# VITE_GROUP_CALLS_ASR_PCM_STREAM=1
# CALL_TRANSCRIPTS_ASR_URL=http://localhost:8099/transcribe
# CALL_TRANSCRIPTS_ASR_WS_URL=ws://127.0.0.1:8100/stream
# CALL_TRANSCRIPTS_ASR_API_KEY=secret

# App Store: ссылка на политику конфиденциальности и email поддержки (по умолчанию https://pingos.ru/privacy и support@pingos.ru)
# VITE_PRIVACY_POLICY_URL=https://pingos.ru/privacy
# VITE_SUPPORT_EMAIL=support@pingos.ru

# Пуш при звонке абоненту не в сети: Legacy Server Key из Firebase Console → Project Settings → Cloud Messaging
# FCM_SERVER_KEY=your-fcm-legacy-server-key

# Секрет для сессий (обязательно свой в проде)
SESSION_SECRET=your-session-secret-change-in-production

# Хранение телефонов в БД: AES-256-GCM + HMAC для поиска/логина (минимум 16 символов). Пусто = номер в колонке users.phone (как раньше).
# PHONE_AT_REST_SECRET=сгенерируйте-длинную-случайную-строку

# Для доступа по HTTPS (например pingos.ru) обязательно true — иначе куки сессии не сохраняются и будет 401
# SESSION_SECURE=true

# Если фронт и API на разных поддоменах (app.pingos.ru и api.pingos.ru) — куки не уходят с sameSite=lax.
# Задайте SESSION_SAME_SITE=none (и SESSION_SECURE=true), чтобы токен звонка и /api/auth/me не давали 401.
# SESSION_SAME_SITE=none

# Отдельная БД для этого проекта (не общая с другими проектами на VPS)
# DATABASE_URL=postgresql://ping_moot:password@localhost:5432/ping_moot

# Сиды seed-social / seed-test-users: кто подписывается на всех тестовых (через запятую). По умолчанию +79956012736.
# SEED_AUTO_FOLLOW_SEEDS_PHONES=+79956012736,+79001234567
# Леха по ссылке профиля pingos.ru/profile/5 → public_id 5:
# SEED_LEKHA_PUBLIC_ID=5
# Если не задано — поиск по имени; иначе телефон:
# SEED_LEKHA_PHONE=+79...
# Иначе скрипт создаст служебного пользователя lekha_prog / test1234 (отключить: SEED_LEKHA_NO_AUTO=1)
# SEED_LEKHA_SEED_PHONE=lekha_prog
# Одноразово подписать существующих seed_social_*: npm run seed:auto-follow
# Для test_seed_*: SEED_AUTO_FOLLOW_PHONE_PREFIX=test_seed_% npm run seed:auto-follow
# Сид сториз: срок жизни в часах (по умолчанию в скрипте 168 = 7 дней). См. docs/SEED_SOCIAL_AND_FEED.md
# SEED_STORY_TTL_HOURS=168

# Лента постов: сколько последних постов берётся в пул перед ранжированием (по умолчанию 800). Если сид-посты «пропали» — увеличьте.
# FEED_RANKING_CANDIDATE_MAX=2500
# FEED_ALGO_MODE=strict_chrono
# Глобальная лента: снапшот в БД (воркер) + чтение без ранжирования на каждый GET (см. docs/FEED_RANKING_ALGORITHM.md)
# FEED_SNAPSHOT_READ_ENABLED=1
# FEED_SNAPSHOT_MAX_AGE_SEC=180
# PM2: FEED_WORKER_PM2_ENABLED=1 — отдельный процесс dist/feed-worker.cjs
# FEED_WORKER_INTERVAL_SEC=90
# Однократный пересчёт (dev): FEED_WORKER_ONCE=1 npm run dev:feed-worker

# Админ-панель: логин и пароль (по умолчанию admin / 667866)
# ADMIN_LOGIN=admin
# ADMIN_PASSWORD=667866

# Cloud.ru Evolution Object Storage (S3-совместимый). Если заданы — голосовые и медиа загружаются в облако.
# Ключ доступа в формате: ID тенанта / Key ID (как в консоли Cloud.ru)
# S3_ENDPOINT=https://s3.cloud.ru
# S3_BUCKET=bucket-7a286d
# S3_REGION=ru-central-1
# S3_ACCESS_KEY=baf59cb2-af71-40ed-a33c-0bab7821c6d9/YOUR_KEY_ID
# S3_SECRET_KEY=your_key_secret
# Чтобы по возвращённому URL медиа открывались без 403: S3_PUBLIC_ACL=1 (если бакет разрешает ACL)

# Админка «Диск»: путь тома для statfs (свободно/всего). По умолчанию — рабочая папка процесса (обычно корень приложения на VPS).
# DISK_STATFS_PATH=/var/www/ping-moot
# Папка проекта для размера на диске и сравнения с ресурсами сервера (по умолчанию = cwd).
# DISK_PROJECT_PATH=/var/www/ping-moot
# Таймаут ms для `du` при измерении папки проекта (по умолчанию 12000). После таймаута — обход без node_modules/.git.
# DISK_PROJECT_DU_TIMEOUT_MS=60000

# Перевод в чате — LLM через OpenRouter (тот же OPENROUTER_API_KEY), не транслитератор. В промпт подмешиваются до 6 предыдущих текстовых реплик для контекста.
# По умолчанию для перевода в чате: openai/gpt-4o-mini (смысл и разговорный тон). Иначе можно задать OPENROUTER_TRANSLATE_MODEL / OPENROUTER_MODEL.
# OPENROUTER_TRANSLATE_MODEL=openai/gpt-4o-mini
# TRANSLATE_DEBUG=1

# AI Search: модель выделяет темы и интересы из небольших порций переписки → таблицы в БД. Нужен OPENROUTER_API_KEY.
# AI_SEARCH_ENABLED=1
# «Горячие» темы под мгновенный таргетинг: TTL в часах при каждом новом упоминании (1–168).
# AI_SEARCH_HOT_TTL_HOURS=48
# In-memory кеш списка hot на пользователя (мс), чтобы не бить Postgres на каждый показ рекламы.
# AI_SEARCH_HOT_L1_MS=45000

# ПИНГОК МИКРО — отдельный процесс голосовых команд (`npm run dev:pingok-micro`). Порт не должен совпадать с PORT основного приложения.
# PINGOK_MICRO_PORT=3091
# Клиент (Vite): fallback на отдельный процесс ПИНГОК МИКРО, если основной API недоступен (без слэша в конце).
# По умолчанию разбор идёт через POST /api/pingok-micro/v1/parse на том же хосте, что и приложение.
# VITE_PINGOK_MICRO_URL=http://localhost:3091

# EDGE — отдельный процесс (`npm run dev:edge`, сборка dist/edge.cjs). По умолчанию слушает только 127.0.0.1.
# Отдельная БД (рекомендуется): после деплоя выполняется EDGE/db/run-migrations.cjs, если задано.
# EDGE_DATABASE_URL=postgresql://user:pass@localhost:5432/ping_moot_edge
# EDGE_PG_POOL_MAX=8
# Платформа: для /api/edge/* нужны EDGE_UPSTREAM_URL + EDGE_SERVICE_SECRET (как на EDGE); иначе 503 JSON.
# EDGE_UPSTREAM_URL=http://127.0.0.1:3092
# EDGE_PROXY_TIMEOUT_MS=2500
# EDGE_SERVICE_SECRET=сгенерируй_длинную_строку_одинаково_на_платформе_и_EDGE
# ЛС победителям после POST /api/admin/edge/draw-prize, если у кампании в EDGE пустой creator_platform_user_id:
# EDGE_PRIZE_NOTIFY_USER_ID=<uuid пользователя-платформы, от имени которого уйдёт сообщение>
# EDGE_BIND=127.0.0.1
# EDGE_PORT=3092
# PM2: процесс edge не добавляется, пока не EDGE_PM2_ENABLED=1
# EDGE_PM2_ENABLED=0
# EDGE_PM2_NAME=ping-moot-edge
# Шаблон ЛС «коды приглашения» (EDGE): плейсхолдер {{appLink}} в pingInviteDm.template
# PING_INVITE_APP_URL=https://apps.apple.com/... или https://play.google.com/...

# ---- PARSER (микросервис ВК, dist/parser.cjs) ----
# Локально проще всего: npm run dev:with-parser (платформа + парсер в одном терминале).
# Или два терминала: npm run dev и npm run dev:parser.
# Та же DATABASE_URL (или PARSER_DATABASE_URL). Миграции: node PARSER/db/run-migrations.cjs
# Шифрование токенов ВК в БД:
# VK_PARSER_TOKEN_KEY=  # openssl rand -hex 32
# Loopback на платформу для публикации постов:
# PARSER_PLATFORM_URL=http://127.0.0.1:3080
# PARSER_SERVICE_SECRET=тот_же_что_ниже_на_платформе
# PARSER_PORT=3093
# PARSER_BIND=127.0.0.1
#
# На процессе платформы (прокси админки → PARSER):
# В development, если строка ниже не задана, прокси сам ходит на http://127.0.0.1:${PARSER_PORT:-3093}
# PARSER_UPSTREAM_URL=http://127.0.0.1:3093
# PARSER_SERVICE_SECRET=сгенерируй_длинную_строку
# PARSER_PROXY_TIMEOUT_MS=25000
# PM2: PARSER_PM2_ENABLED=1
# PARSER_PM2_NAME=ping-moot-parser
