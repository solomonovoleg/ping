# Деплой сам создаст deploy.env из этого файла при первом запуске npm run deploy.
# Подставь VPS_PASSWORD и DATABASE_URL. При каждом деплое .env на сервере берётся отсюда — править на сервере не надо.
#
# Аудит: какие переменные есть в коде, что копируется на сервер (build_server_env), что только VITE_* при сборке —
# см. docs/ENV_REFERENCE.md

# ---- Подключение к серверу (обязательно для деплоя) ----
VPS_HOST=130.49.150.92
VPS_USER=root
# Пароль от сервера (если вход по ключу — оставь пустым)
VPS_PASSWORD=

# ---- Приложение на сервере (деплой запишет это в .env на сервере) ----
PORT=3080
# Папка на VPS (второй инстанс/staging: /var/www/ping-moot-staging)
# VPS_PATH=/var/www/ping-moot
# Имя процесса PM2 на этом сервере — обязательно уникально, иначе staging перезапишет prod
# PM2_APP_NAME=ping-moot
# Сгенерируется сам при первом создании deploy.env. При деплое сохраняется с сервера — сессии не сбрасываются.
SESSION_SECRET=
# Шифрование телефонов в БД (мин. 16 символов). Пусто — старый режим plaintext в users.phone.
# PHONE_AT_REST_SECRET=

# Кука сессии: в production по умолчанию secure=true (HTTPS). Если заходите по http://IP:3080 — SESSION_SECURE=false.
# Для кросс-домена (фронт и API на разных поддоменах) добавь SESSION_SAME_SITE=none (нужен HTTPS).
SESSION_SECURE=true

# PostgreSQL (обязательно — без него теряется доступ к БД). При каждом деплое записывается в .env на сервере.
# Формат: postgresql://ping_moot:ПАРОЛЬ@localhost:5432/ping_moot
# Можно задать полную строку в DATABASE_URL или только пароль: DB_PASSWORD=твой_пароль (тогда скрипт подставит localhost и ping_moot).
DATABASE_URL=

# Пул соединений к PostgreSQL на один процесс Node (см. ecosystem.config.cjs — обычно 1 инстанс).
# По умолчанию 40: нормально при сотнях–тысяче одновременных коротких запросов (логин, пост, метаданные).
# Не превышайте max_connections в Postgres (на VPS часто 100–200); при нескольких воркерах PM2 — делите лимит между ними.
# PG_POOL_MAX=40

# Админ-панель
ADMIN_LOGIN=admin
ADMIN_PASSWORD=667866

# Пуши (новое сообщение, входящий звонок): без FCM_SERVER_KEY сервер не отправляет ничего.
# Ключ: Firebase Console → Project settings → Cloud Messaging → Server key (legacy) или см. docs по FCM HTTP v1.
# iOS: в приложении нужен FCM-токен (Firebase + GoogleService-Info.plist + APNs key в Firebase), иначе Capacitor отдаёт только APNs-токен — он не подходит для текущего FCM send на бэкенде.
# Android: нужен google-services.json в android/app/ (тот же Firebase-проект).
# FCM_SERVER_KEY=AAAA...

# AI OVER и перевод входящих в чате — OpenRouter. Без ключа AI и перевод не работают.
# OPENROUTER_API_KEY=sk-or-v1-...
# Перевод в чате — LLM, до 10 предыдущих реплик в контексте; по умолчанию openai/gpt-4o-mini. Переопределение: OPENROUTER_TRANSLATE_MODEL=...
# OPENROUTER_MODEL=openai/gpt-3.5-turbo
# OPENROUTER_TRANSLATE_MODEL=openai/gpt-4o-mini
# AI Search (отключить явно): AI_SEARCH_ENABLED=0
# AI_SEARCH_HOT_TTL_HOURS=48
# AI_SEARCH_HOT_L1_MS=45000

# S3 (облако для медиа/аватаров): S3_ENDPOINT, S3_BUCKET, S3_REGION, S3_ACCESS_KEY, S3_SECRET_KEY, S3_PUBLIC_ACL=1

# Звонки (WebSocket): если фронт и бэкенд на одном домене (например https://pingos.ru), можно не задавать.
# Если фронт на другом домене/CDN — задай тот же хост, где Node: VITE_WS_URL=https://pingos.ru
# При деплое эта переменная подхватывается при сборке (scripts/deploy.sh).
# VITE_WS_URL=https://pingos.ru
# Если SPA ходит в API на другом origin:
# VITE_API_URL=https://api.pingos.ru
# Таймауты звонков на клиенте (мс), см. client/src/features/call/call-types.ts:
# VITE_CALLS_RING_TIMEOUT_MS=60000
# VITE_CALLS_ACCEPT_TIMEOUT_MS=15000
# VITE_CALLS_CONNECT_TIMEOUT_MS=20000
# VITE_CALLS_RECONNECT_TIMEOUT_MS=8000
#
# ---- ПИНГОК МИКРО (отдельный процесс на VPS, PM2 + dist/pingok-micro.cjs) ----
# Порт на localhost; снаружи — только через nginx (см. docs/DEPLOY.md).
# PINGOK_MICRO_PORT=3091
# Обязательно для продакшена SPA: иначе fetch с сайта заблокирует CORS (через запятую несколько доменов).
# PINGOK_MICRO_CORS_ORIGIN=https://pingos.ru
# Отключить второй процесс PM2: PINGOK_MICRO_PM2_ENABLED=0
# Имя процесса в pm2 list (по умолчанию pingok-micro)
# PINGOK_PM2_NAME=pingok-micro
#
# ---- EDGE микросервис (опционально; не ломает основное приложение) ----
# Отдельная БД для EDGE (миграции EDGE/migrations при деплое, если строка задана).
# EDGE_DATABASE_URL=postgresql://ping_moot_edge:ПАРОЛЬ@localhost:5432/ping_moot_edge
# Прокси с платформы на localhost (nginx наружу не открывает). Без EDGE_UPSTREAM_URL — только заглушки.
# EDGE_UPSTREAM_URL=http://127.0.0.1:3092
# EDGE_SERVICE_SECRET=
# EDGE_PROXY_TIMEOUT_MS=2500
# EDGE_BIND=127.0.0.1
# EDGE_PORT=3092
# Явно включить процесс в PM2: EDGE_PM2_ENABLED=1 (иначе только ping-moot [+ pingok])
# EDGE_PM2_ENABLED=0
# EDGE_PM2_NAME=ping-moot-edge
#
# ---- PARSER микросервис (ВК) + прокси на платформе ----
# Общий секрет (платформа → PARSER и PARSER → POST /internal/parser/publish):
# PARSER_SERVICE_SECRET=
# Платформа: куда слушает parser (loopback)
# PARSER_UPSTREAM_URL=http://127.0.0.1:3093
# PARSER_PROXY_TIMEOUT_MS=25000
# Процесс parser: URL основного API (без /api)
# PARSER_PLATFORM_URL=http://127.0.0.1:3080
# VK_PARSER_TOKEN_KEY=  # openssl rand -hex 32
# PARSER_PORT=3093
# PARSER_PM2_ENABLED=0
# PARSER_PM2_NAME=ping-moot-parser
#
# Воркер глобальной ленты: пересчёт feed_global_snapshot (после миграции 0031). Не HTTP — только БД.
# FEED_WORKER_PM2_ENABLED=0
# FEED_WORKER_PM2_NAME=ping-moot-feed-worker
# FEED_WORKER_INTERVAL_SEC=90
# FEED_SNAPSHOT_MAX_AGE_SEC=180
# Остальные FEED_* (ранжирование, лимиты кандидатов) — см. .env.example и docs/ENV_REFERENCE.md
#
# Fallback в клиенте, если /api/pingok-micro/v1/parse недоступен. Через nginx, без открытия 3091 наружу:
# VITE_PINGOK_MICRO_URL=https://pingos.ru/pingok-micro-standalone
#
# TURN для WebRTC (очень рекомендуется в проде, иначе в части сетей звонки не соединяются).
# Логин/пароль должны совпадать с пользователем в coturn (lt-cred-mech). Регистрация нигде не нужна.
# После правок — npm run deploy, чтобы VITE_* попали в клиентский бандл.
# Пример для pingos.ru (coturn на 3478 UDP+TCP; см. docs/CALLS_TURN_SETUP.md):
# VITE_TURN_URLS=turn:pingos.ru:3478?transport=udp,turn:pingos.ru:3478?transport=tcp
# VITE_TURN_USERNAME=ЗАМЕНИ_НА_ЛОГИН_ИЗ_TURNSERVER_CONF
# VITE_TURN_CREDENTIAL=ЗАМЕНИ_НА_ПАРОЛЬ_ИЗ_TURNSERVER_CONF
# Опционально TLS (если подняли turns на 5349):
# VITE_TURN_URLS=turn:pingos.ru:3478?transport=udp,turn:pingos.ru:3478?transport=tcp,turns:pingos.ru:5349?transport=tcp
#
# Подробные серверные логи сигналинга звонков (для отладки): 1 = включить, 0 = выключить.
# CALLS_DEBUG=1
#
# Групповые звонки (mesh WebRTC, отдельный WS /group-calls). Нужны оба флага + nginx location = /group-calls.
# Демонстрация экрана в группе — тот же флаг, что для личного видеозвонка:
# VITE_CALLS_FEATURE_SCREEN_SHARE=1
# GROUP_CALLS_ENABLED=1
# VITE_GROUP_CALLS_ENABLED=1
# GROUP_CALLS_SERVER_ASR_ENABLED=1
# VITE_GROUP_CALLS_SERVER_ASR=1
# CALL_TRANSCRIPTS_ASR_URL=http://127.0.0.1:8099/transcribe
# CALL_TRANSCRIPTS_ASR_WS_URL=ws://127.0.0.1:8100/stream
# CALL_TRANSCRIPTS_ASR_API_KEY=secret
