# Деплой сам создаст deploy.env из этого файла при первом запуске npm run deploy.
# Подставь VPS_PASSWORD и DATABASE_URL. При каждом деплое .env на сервере берётся отсюда — править на сервере не надо.

# ---- Подключение к серверу (обязательно для деплоя) ----
VPS_HOST=130.49.150.92
VPS_USER=root
# Пароль от сервера (если вход по ключу — оставь пустым)
VPS_PASSWORD=

# ---- Приложение на сервере (деплой запишет это в .env на сервере) ----
PORT=3080
# Папка на VPS (второй инстанс/staging: /var/www/ping-moot-staging)
# VPS_PATH=/var/www/ping-moot
# Имя процесса PM2 на этом сервере — обязательно уникально, иначе staging перезапишет prod
# PM2_APP_NAME=ping-moot
# Сгенерируется сам при первом создании deploy.env. При деплое сохраняется с сервера — сессии не сбрасываются.
SESSION_SECRET=
# Кука сессии: в production по умолчанию secure=true (HTTPS). Если заходите по http://IP:3080 — SESSION_SECURE=false.
# Для кросс-домена (фронт и API на разных поддоменах) добавь SESSION_SAME_SITE=none (нужен HTTPS).
SESSION_SECURE=true

# PostgreSQL (обязательно — без него теряется доступ к БД). При каждом деплое записывается в .env на сервере.
# Формат: postgresql://ping_moot:ПАРОЛЬ@localhost:5432/ping_moot
# Можно задать полную строку в DATABASE_URL или только пароль: DB_PASSWORD=твой_пароль (тогда скрипт подставит localhost и ping_moot).
DATABASE_URL=

# Админ-панель
ADMIN_LOGIN=admin
ADMIN_PASSWORD=667866

# FCM_SERVER_KEY= (по желанию)

# AI OVER и перевод входящих в чате — OpenRouter. Без ключа AI и перевод не работают.
# OPENROUTER_API_KEY=sk-or-v1-...
# Модель по умолчанию: openai/gpt-3.5-turbo. Только для перевода в чате: OPENROUTER_TRANSLATE_MODEL=...
# OPENROUTER_MODEL=openai/gpt-3.5-turbo

# S3 (облако для медиа/аватаров): S3_ENDPOINT, S3_BUCKET, S3_REGION, S3_ACCESS_KEY, S3_SECRET_KEY, S3_PUBLIC_ACL=1

# Звонки (WebSocket): если фронт и бэкенд на одном домене (например https://pingos.ru), можно не задавать.
# Если фронт на другом домене/CDN — задай тот же хост, где Node: VITE_WS_URL=https://pingos.ru
# При деплое эта переменная подхватывается при сборке (scripts/deploy.sh).
# VITE_WS_URL=https://pingos.ru
#
# TURN для WebRTC (очень рекомендуется в проде, иначе в части сетей звонки не соединяются).
# Можно несколько URL через запятую, например:
# VITE_TURN_URLS=turn:turn.pingos.ru:3478,turns:turn.pingos.ru:5349
# VITE_TURN_USERNAME=ping
# VITE_TURN_CREDENTIAL=strong-password
#
# Подробные серверные логи сигналинга звонков (для отладки): 1 = включить, 0 = выключить.
# CALLS_DEBUG=1
