# Скопируй в deploy.staging.env (локально, не в git) ИЛИ вставь весь текст в GitHub Secret STAGING_DEPLOY_ENV.
# Подставь свои пароли и секреты.

VPS_HOST=130.49.150.92
VPS_USER=root
VPS_PASSWORD=

# Staging: отдельная папка и процесс PM2
PORT=3081
VPS_PATH=/var/www/ping-moot-staging
PM2_APP_NAME=ping-moot-staging

# Отдельная БД для staging
DATABASE_URL=postgresql://ping_moot_staging:ПАРОЛЬ@localhost:5432/ping_moot_staging

SESSION_SECRET=
SESSION_SECURE=true

# Опционально
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Сборка Vite (если нужен отдельный WS/API для стенда)
# VITE_WS_URL=https://dev.example.com
# VITE_API_URL=
